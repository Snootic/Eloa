# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.11.16 AS uv

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    HF_HOME=/cache/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg libsndfile1 libgomp1 libportaudio2 espeak-ng \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml README.md ./
RUN uv venv /opt/venv --python 3.12

ARG UV_EXTRAS="--extra kokoro"
RUN uv pip install --python /opt/venv/bin/python --torch-backend=cpu \
        -r pyproject.toml ${UV_EXTRAS}

COPY tts_core ./tts_core
COPY providers ./providers
COPY server ./server
COPY main.py torching.py ./
COPY config ./config

ENV TTS_PROVIDER=pocket-tts \
    TTS_MODEL=portuguese \
    TTS_MODEL_CATALOG=/app/config/models.json \
    TTS_VOICE=camilly-portuguese \
    TTS_HOST=0.0.0.0 \
    TTS_PORT=8082

EXPOSE 8082
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8082/health')" || exit 1
CMD ["python", "main.py"]
